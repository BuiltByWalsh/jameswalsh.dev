{
  "name": "jameswalsh.dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port=3000",
    "dev:force": "rm -rf .next && pnpm dev",
    "db:migrate": "echo 'no migrations yet'",
    "build": "next build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "precommit": "pnpm spell && pnpm lint-staged",
    "prepush": "pnpm typecheck && vitest --run",
    "prepare": "husky install",
    "preview": "pnpm build && pnpm start",
    "start": "next start",
    "spell": "cspell",
    "test:unit": "vitest",
    "test:unit:ci": "vitest --run --coverage",
    "test:e2e:open": "playwright test --headed",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --pretty"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "date-fns": "4.1.0",
    "front-matter": "4.0.2",
    "geist": "1.4.2",
    "lucide-react": "0.562.0",
    "neverthrow": "8.2.0",
    "next": "16.4.0",
    "next-mdx-remote": "6.0.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rss": "1.2.2",
    "sharp": "0.35.5",
    "shiki": "3.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.6.0",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/rss": "0.0.32",
    "@vitejs/plugin-react": "4.6.0",
    "@vitest/coverage-istanbul": "4.0.16",
    "commitlint": "19.8.1",
    "cspell": "8.15.1",
    "happy-dom": "20.8.9",
    "husky": "8.0.3",
    "lint-staged": "16.1.2",
    "msw": "2.10.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "postcss": "8.5.23",
    "rehype": "13.0.2",
    "rehype-autolink-headings": "7.1.0",
    "rehype-pretty-code": "0.14.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.8.3",
    "vite-tsconfig-paths": "6.0.3",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "pnpm run lint"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.11.0"
}
